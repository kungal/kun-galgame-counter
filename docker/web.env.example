# kun-galgame-counter runtime config.
# Copy to docker/web.env (gitignored) and fill in. Read at runtime via env_file.
#
# Salt for hashing visitor IPs before they touch disk, so repeat votes can be
# deduped WITHOUT storing raw IPs. Set a long random value in production and keep
# it stable — changing it resets per-IP dedup (everyone gets to vote once more).
# Optional: the app falls back to a built-in default if this is unset.
COUNTER_IP_SALT=change-me-to-a-long-random-string
