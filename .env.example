# Docker port config — the ONE place to change the app port.
#
# This file is just a template. The compose files have these same values as
# inline defaults (${WEB_PORT:-2326}), so the stack runs with NO .env at all.
# You only need a .env to OVERRIDE the port:
#
#   • Local:  cp .env.example .env  and edit WEB_PORT  (.env is gitignored)
#   • Prod:   set WEB_PORT in Dokploy → your app → Environment (no file needed),
#             and set the same number as the Domains "Container Port".
#
# Non-secret only. Secrets (COUNTER_IP_SALT) go in docker/web.env, never here.

# Port the app listens on inside the container (= Dokploy Container Port).
WEB_PORT=2326

# Dev only: host port docker-compose.yml publishes (http://localhost:HOST_PORT).
HOST_PORT=15014
